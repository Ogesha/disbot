# =============================
# Discord
# =============================
DISCORD_TOKEN=PUT_YOUR_DISCORD_BOT_TOKEN_HERE

# =============================
# PostgreSQL
# =============================
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DATABASE=discord_bot

# =============================
# Telegram logging
# =============================
TG_BOT_TOKEN=
TG_CHAT_ID=

# =============================
# GIFs
# =============================
GIF_FOLDER=./gifs/
GIF_SAFONOV_OPLATIT=safonov_oplatit.gif
GIF_ILYA_MUROMETS=ilya_muromets.gif
GIF_REMINDER_LIST=

# =============================
# Reminders
# =============================
REMINDER_ENABLED=true
REMINDER_INTERVAL_HOURS=24
REMINDER_MESSAGE=Напоминание: у вас есть неоплаченный штраф {link}.
REMINDER_LOG_ENABLED=false
REMINDER_LOG_CHANNEL_ID=0
REMINDER_LOG_ROLE_ID=0

# =============================
# Feature flags
# =============================
MODERATION_ENABLED=false
ANTISPAM_ENABLED=false
NEW_MEMBER_VERIFICATION_ENABLED=false
ANTI_NUKE_ENABLED=false
BACKUP_ENABLED=false

# =============================
# Backup
# =============================
BACKUP_INTERVAL_HOURS=24
BACKUP_FOLDER=./backups/
BACKUP_MAX_KEEP=5
BACKUP_NOTIFY_CHANNEL_ID=0

# =============================
# Stalcraft API
# =============================
STALCRAFT_CLIENT_ID=0
STALCRAFT_CLIENT_SECRET=
STALCRAFT_REGION=eu

# =============================
# Default command channels
# =============================
COMMAND_CHANNEL_IDS=
LINK_CHANNEL_ID=0
LINK_COMMAND_CHANNEL_ID=0

# =============================
# Punishment roles
# =============================
FINE_ROLE_ID=0
WARN_ROLE_1_ID=0
WARN_ROLE_2_ID=0
WARN_ROLE_3_ID=0

# =============================
# Clan 1
# =============================
CLAN1_NAME=
CLAN1_MEMBER_ROLE_IDS=
CLAN1_EX_MEMBER_ROLE_IDS=
CLAN1_HIGH_RANK_ROLE_IDS=
CLAN1_NICK_PREFIX=
CLAN1_EX_NICK_PREFIX=
CLAN1_COMMAND_CHANNEL_ID=0

# =============================
# Clan 2
